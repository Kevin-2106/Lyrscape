{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyrscape",
  "version": "0.1.0",
  "identifier": "io.github.kevin2106.lyrscape",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lyrscape",
        "width": 1280,
        "height": 860,
        "minWidth": 860,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": false
      },
      {
        "label": "overlay",
        "title": "Lyrscape Desktop Lyrics",
        "url": "index.html?surface=overlay",
        "width": 1100,
        "height": 220,
        "minWidth": 320,
        "resizable": true,
        "minHeight": 90,
        "x": 100,
        "y": 650,
        "transparent": true,
        "backgroundColor": "#00000000",
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "devCsp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Extensible desktop lyrics",
    "category": "Music"
  }
}
